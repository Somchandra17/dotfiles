{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        },
        "color": {
            "1": "blue",
            "2": "white"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "blue",
            "title": "white"
        },
        "key": {
            "width": 10
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "key": " "
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "  OS"
        },
        {
            "type": "kernel",
            "key": "  Kernel"
        },
        {
            "type": "uptime",
            "key": " 󰅐 Uptime"
        },
        {
            "type": "shell",
            "key": "  Shell"
        },
        {
            "type": "terminal",
            "key": "  Term"
        },
        {
            "type": "cpu",
            "key": " 󰻠 CPU",
            "showPeCoreCount": false
        },
        {
            "type": "memory",
            "key": " 󰍛 Memory"
        },
        {
            "type": "disk",
            "key": " 󰋊 Disk",
            "folders": "/"
        },
        {
            "type": "battery",
            "key": " 󰁹 Battery"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
