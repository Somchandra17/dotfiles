#!/usr/bin/env python3
"""Consume or expel a window, then keep stacked windows on screen.

niri stacks full-height windows in a column, so the extra window sits below
the monitor. After a consume/expel, share the column height when two or more
windows share it.
"""

import json
import subprocess
import sys


def msg(*args):
    return subprocess.run(["niri", "msg", *args], check=False, capture_output=True)


def msg_json(*args):
    out = subprocess.check_output(["niri", "msg", "-j", *args])
    return json.loads(out)


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("left", "right"):
        sys.exit("usage: niri-stack-keep-visible left|right")
    msg("action", f"consume-or-expel-window-{sys.argv[1]}")
    focused = msg_json("focused-window")
    if not focused:
        return
    pos = (focused.get("layout") or {}).get("pos_in_scrolling_layout")
    workspace = focused.get("workspace_id")
    if not pos:
        return
    column = pos[0]
    same = []
    for window in msg_json("windows"):
        if window.get("workspace_id") != workspace:
            continue
        other = (window.get("layout") or {}).get("pos_in_scrolling_layout")
        if other and other[0] == column:
            same.append(window)
    if len(same) < 2:
        return
    height = f"{max(1, 100 // len(same))}%"
    for window in same:
        msg("action", "set-window-height", "--id", str(window["id"]), height)


if __name__ == "__main__":
    main()
