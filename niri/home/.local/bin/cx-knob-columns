#!/usr/bin/env python3
"""Map the CX keyboard knob to niri column focus.

The receiver exposes the knob as a horizontal wheel on its consumer-control
device. That device is not a pointer, so niri never sees the wheel. One notch
focuses the column to the right or left, the same actions as Mod+Right and
Mod+Left.
"""

import os
import select
import struct
import subprocess

# linux/input.h input_event on x86_64: timeval (16) + type + code + value.
EVENT = struct.Struct("llHHi")
EV_REL = 0x02
REL_HWHEEL = 0x06
NAME = "CX 2.4G Wireless Receiver Consumer Control"


def find_device() -> str:
    root = "/sys/class/input"
    for entry in os.listdir(root):
        if not entry.startswith("input"):
            continue
        name_path = os.path.join(root, entry, "name")
        try:
            with open(name_path, encoding="utf-8") as handle:
                if handle.read().strip() != NAME:
                    continue
        except OSError:
            continue
        for node in os.listdir(os.path.join(root, entry)):
            if node.startswith("event"):
                return f"/dev/input/{node}"
    raise SystemExit(f"input device not found: {NAME}")


def focus(direction: int) -> None:
    action = "focus-column-right" if direction > 0 else "focus-column-left"
    subprocess.run(
        ["niri", "msg", "action", action],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def main() -> None:
    path = find_device()
    print(f"listening on {path}", flush=True)
    fd = os.open(path, os.O_RDONLY)
    while True:
        readable, _, _ = select.select([fd], [], [])
        if not readable:
            continue
        data = os.read(fd, EVENT.size * 64)
        if not data:
            raise SystemExit("knob device closed")
        for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _sec, _usec, typ, code, value = EVENT.unpack_from(data, offset)
            if typ == EV_REL and code == REL_HWHEEL and value:
                focus(value)


if __name__ == "__main__":
    main()
